name: MIRTI68 Aktar

on:
  schedule:
    - cron: '0 */1 * * *'  # 1 saatte bir
  workflow_dispatch:  # Elle çalıştır butonu

permissions:
  contents: write

concurrency:
  group: mirti68-aktar
  cancel-in-progress: false

jobs:
  aktar:
    runs-on: ubuntu-latest
    steps:
      - name: Repo çek
        uses: actions/checkout@v4

      - name: Python kur
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Aktar çalıştır
        run: python aktar.py

      - name: Degisikligi kaydet
        if: always()
        run: |
          git config user.name "mirti68-bot"
          git config user.email "mirti68-bot@users.noreply.github.com"
          git stash push -m "auto" --include-untracked || true
          git pull --rebase || true
          git stash pop || true
          git add mirti68.m3u || true
          git add hatali_url_listesi.txt || true
          git diff --cached --quiet || git commit -m "Otomatik aktarim" || true
          git push || echo "Push atlandi, sonraki calismada denenecek"
